{
  "name": "dsh-theme-presets",
  "version": "0.1.2",
  "description": "Preset color themes for the DSH Web GUI: Nord, Dracula, Catppuccin, Tokyo Night, One Dark, Gruvbox, Solarized and GitHub, layered over the --dsw-alias-* token surface.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MicroSharpAnt/dsh-theme-presets.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "theme",
    "color-scheme"
  ],
  "main": "./host.js",
  "exports": {
    ".": { "default": "./host.js" },
    "./client": { "types": "./lib/client.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "files": [
    "host.js",
    "presets.mjs",
    "cordis.patch.yml",
    "src",
    "lib",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "node build-client.mjs",
    "test": "node verify-contract.mjs && node schema-test.mjs && node self-test.mjs && node host-test.mjs && node bundle-test.mjs",
    "test:e2e": "node e2e-test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
